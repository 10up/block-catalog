{
  "name": "10up/block-catalog-plugin",
  "description": "Keep track of which Gutenberg Blocks are used across your site.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Darshan Sawardekar",
      "email": "darshan@10up.com",
      "role": "developer"
    },
    {
      "name": "10up",
      "email": "opensource@10up.com",
      "role": "developer"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "10up/phpcs-composer": "~3@RC",
    "squizlabs/php_codesniffer": "~3.13.6",
    "yoast/phpunit-polyfills": "^4.0",
    "phpunit/phpunit": "^9.6",
    "sirbrillig/phpcs-changed": "^2.11",
    "wp-phpunit/wp-phpunit": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "BlockCatalog\\": "includes/classes/"
    }
  },
  "scripts": {
    "lint": "phpcs includes",
    "lint-fix": "phpcbf includes"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
