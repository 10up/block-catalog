{
  "name": "block-catalog-plugin",
  "description": "Keep track of which Gutenberg Blocks are used across your site.",
  "version": "1.6.3",
  "license": "GPL-2.0-or-later",
  "author": {
    "name": "Darshan Sawardekar",
    "email": "darshan@10up.com"
  },
  "scripts": {
    "start": "npm run watch",
    "build": "10up-toolkit build",
    "dev": "10up-toolkit build --watch",
    "watch": "10up-toolkit build --watch",
    "format-js": "10up-toolkit format-js assets/js",
    "lint-js": "10up-toolkit lint-js assets/js",
    "lint-style": "10up-toolkit lint-style assets/css",
    "clean-dist": "rm -rf ./dist",
    "build-release": "npm install && composer install --no-dev -o && npm run build && npm run build-release-zip",
    "build-release-zip": "mkdir -p releases && bin/build-release-zip.sh $npm_package_version",
    "build-release-svn": "mkdir -p releases/svn && bin/build-release-svn.sh $npm_package_version",
    "wp-env": "wp-env",
    "wp-env:test": "wp-env --config=.wp-env.test.json",
    "test:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/block-catalog vendor/bin/phpunit -c phpunit.xml.dist --exclude-group ms-required",
    "test:php:multisite": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/block-catalog env WP_MULTISITE=1 vendor/bin/phpunit -c phpunit.xml.dist",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config tests/e2e/playwright.config.ts --ui"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@wordpress/e2e-test-utils-playwright": "3.3.0",
    "@wordpress/env": "12.2.0",
    "10up-toolkit": "^7.0.0",
    "prettier": "^3.2.5",
    "terser-webpack-plugin": "^5.6.1"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "10up-toolkit": {
    "entry": {
      "tools": "./assets/js/admin/tools.js"
    }
  }
}
